{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klipp",
  "version": "0.2.1",
  "identifier": "dev.klipp.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Klipp",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#1e1e1d",
        "theme": "Dark",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Klipp",
    "copyright": "Copyright (c) 2026 The Klipp contributors",
    "homepage": "https://github.com/alonsy/klipp",
    "license": "MIT",
    "category": "Video",
    "shortDescription": "A light, always-on clip recorder",
    "longDescription": "Klipp keeps your last moments ready to save with a hotkey, clips Counter-Strike 2 highlights by itself, and helps you trim and share them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNkE1RTg3MTRCQzc1RTQKUldUa2Rid1VoMTVxUEFVaXZ6NnJKSkhzUitwbnNoQzhRcitBamMzVTRrU2FCR3huQWtQNnRJeWYK",
      "endpoints": [
        "https://github.com/alonsy/klipp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
